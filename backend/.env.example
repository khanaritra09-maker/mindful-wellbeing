# Copy this file to .env for local development, then replace the key.
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MINDFUL_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Production only: use a secret manager for the DB credentials and add sslmode=verify-full.
# postgresql+psycopg://<user>:<password>@<host>:5432/mindful?sslmode=verify-full
# Local development alternative: sqlite:///./backend/data/mindful.db
DATABASE_URL=sqlite:///./backend/data/mindful.db
# Optional override; must be a private directory outside the project and every web/static root.
# VOICE_STORAGE_PATH=/srv/mindful-private/voice_samples
ACCESS_TOKEN_MINUTES=20
# Cross-site GitHub Pages deployment: set to none together with COOKIE_SECURE=true.
SESSION_COOKIE_SAMESITE=lax
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
MAX_VOICE_SAMPLE_BYTES=10485760
APP_ENV=development
# Production: APP_ENV=production, HTTPS-only origins, real PostgreSQL, and Redis.
RATE_LIMIT_STORAGE_URI=memory://
ALLOWED_HOSTS=localhost,127.0.0.1
AUDIT_RETENTION_DAYS=365
MAX_EXPORT_BYTES=104857600
